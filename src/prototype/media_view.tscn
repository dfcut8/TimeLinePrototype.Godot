[gd_scene format=3]
[ext_resource type="Script" path="res://prototype/media_view.gd" id="script"]

[node name="MediaView" type="VBoxContainer"]
script = ExtResource("script")
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="Surface" type="AspectRatioContainer" parent="."]
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_vertical = 3
custom_minimum_size = Vector2(180, 180)
ratio = 1.77778

[node name="Backdrop" type="ColorRect" parent="Surface"]
color = Color(0.025, 0.045, 0.065, 1)
mouse_filter = 2

[node name="Image" type="TextureRect" parent="Surface"]
unique_name_in_owner = true
expand_mode = 1
stretch_mode = 5
mouse_filter = 2

[node name="Video" type="VideoStreamPlayer" parent="Surface"]
unique_name_in_owner = true
expand = true
autoplay = false
visible = false
focus_mode = 2

[node name="MediaStatus" type="Label" parent="."]
unique_name_in_owner = true
text = "Media"
autowrap_mode = 3
max_lines_visible = 3
text_overrun_behavior = 3

[node name="Controls" type="HFlowContainer" parent="."]
unique_name_in_owner = true

[node name="Play" type="Button" parent="Controls"]
unique_name_in_owner = true
text = "Play"
focus_mode = 2

[node name="Restart" type="Button" parent="Controls"]
unique_name_in_owner = true
text = "Restart"
focus_mode = 2

[node name="Mute" type="Button" parent="Controls"]
unique_name_in_owner = true
text = "Mute"
focus_mode = 2

[node name="Retry" type="Button" parent="Controls"]
unique_name_in_owner = true
text = "Retry media"
focus_mode = 2

[node name="Volume" type="HSlider" parent="Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 32)
max_value = 1.0
step = 0.05
value = 0.5
focus_mode = 2

[node name="Elapsed" type="Label" parent="Controls"]
unique_name_in_owner = true
text = "0:00"

